<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Yerel gizli anahtarlar (ör. Llm:OpenRouter:ApiKey) — dotnet user-secrets; depoya girmez. -->
    <UserSecretsId>beautyasist-api-7c1f3e2a</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <!-- SignalR backplane — YALNIZCA Redis:ConnectionString verilirse devreye girer (çok instance). -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" Version="10.0.15" />
    <!-- Redis paketi MessagePack 2.5.187'yi getiriyor; o sürümde yüksek önemli güvenlik açıkları var
         (GHSA-hv8m-jj95-wg3x, GHSA-vh6j-jc39-fggf; 2.5.302 de GHSA-qhrr-8q5h-9q3h). Yamalı sürüme sabitlenir. -->
    <PackageReference Include="MessagePack" Version="2.5.307" />
    <!-- GÜVENLİK: AspNetCore.OpenApi'nin transitive olarak getirdiği Microsoft.OpenApi 2.0.0'da bilinen
         yüksek önem dereceli açık var (NU1903 / GHSA-v5pm-xwqc-g5wc). Aynı major içinde yamalı sürüme
         sabitleyip transitive referansı geçersiz kılıyoruz. -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.13.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.7">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Scalar.AspNetCore" Version="2.14.14" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="9.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GuzellikMerkezi.Application\GuzellikMerkezi.Application.csproj" />
    <ProjectReference Include="..\GuzellikMerkezi.Infrastructure\GuzellikMerkezi.Infrastructure.csproj" />
  </ItemGroup>

</Project>
